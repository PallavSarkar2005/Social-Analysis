# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS base
WORKDIR /app

# Playwright + Python scraping deps used by postinstall / jobs
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY backend/package.json backend/package-lock.json ./
# Skip heavy postinstall during dependency layer; install browsers in next stage if needed
RUN npm ci --ignore-scripts

FROM base AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY backend/ ./

# Install native tooling expected by scrapers (best-effort)
RUN npm rebuild || true \
 && (pip3 install --break-system-packages twscrape twikit || pip3 install twscrape twikit || true) \
 && npx playwright install --with-deps chromium || true

EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
